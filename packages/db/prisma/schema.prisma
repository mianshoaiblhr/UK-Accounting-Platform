// ───────────── V1 ledger core (ADR-44..48) ─────────────
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// Chart of accounts, per company. Deactivated (active dates), never deleted; identity fields are immutable once the account has postings.
model Account {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String      @map("organisation_id") @db.Uuid
  companyId        String      @map("company_id") @db.Uuid
  code             String
  name             String
  type             AccountType
  subtype          String
  isControl        Boolean     @default(false) @map("is_control")
  controlKind      String?     @map("control_kind")
  taxTreatment     String      @default("NOT_APPLICABLE") @map("tax_treatment")
  reportingMapping String      @map("reporting_mapping")
  activeFrom       DateTime?   @map("active_from") @db.Date
  activeTo         DateTime?   @map("active_to") @db.Date
  isSystem         Boolean     @default(false) @map("is_system")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, companyId, code])
  @@unique([organisationId, companyId, id])
  @@map("account")
}

model LedgerSequence {
  organisationId String @map("organisation_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid
  lastNumber     Int    @default(0) @map("last_number")

  @@id([organisationId, companyId])
  @@map("ledger_sequence")
}

/// One posted accounting event. Written ONLY by the PostingService (packages/accounting); immutable.
model Journal {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String   @map("organisation_id") @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  periodId          String   @map("period_id") @db.Uuid
  journalNumber     Int      @map("journal_number")
  journalDate       DateTime @map("journal_date") @db.Date
  sourceType        String   @map("source_type")
  sourceId          String?  @map("source_id")
  sourceReference   String?  @map("source_reference")
  description       String
  currency          String   @db.Char(3)
  total             Decimal  @db.Decimal(19, 4)
  lineCount         Int      @map("line_count")
  actorType         String   @map("actor_type")
  postedByUserId    String?  @map("posted_by_user_id") @db.Uuid
  postedAt          DateTime @default(now()) @map("posted_at") @db.Timestamptz(3)
  correlationId     String?  @map("correlation_id")
  idempotencyKey    String   @map("idempotency_key")
  contentHash       String   @map("content_hash")
  reversesJournalId String?  @unique @map("reverses_journal_id") @db.Uuid
  /// Set only for opening balances and control adjustments (ADR-49).
  requestId         String?  @unique @map("request_id") @db.Uuid
  requestedByUserId String?  @map("requested_by_user_id") @db.Uuid
  approvedByUserId  String?  @map("approved_by_user_id") @db.Uuid
  /// DEC-037: why a person took a cash-in-hand account below zero (the database refuses it otherwise).
  negativeCashReason String? @map("negative_cash_reason")

  lines JournalLine[]

  @@unique([organisationId, companyId, journalNumber])
  @@unique([organisationId, companyId, idempotencyKey])
  @@unique([organisationId, companyId, id])
  @@unique([organisationId, id])
  @@index([organisationId, companyId, journalDate])
  @@index([organisationId, companyId, sourceType, sourceId])
  @@map("journal")
}

model JournalLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  journalId      String   @map("journal_id") @db.Uuid
  lineNo         Int      @map("line_no")
  accountId      String   @map("account_id") @db.Uuid
  debit          Decimal  @default(0) @db.Decimal(19, 4)
  credit         Decimal  @default(0) @db.Decimal(19, 4)
  description    String?
  /// Original-currency values (ADR-55): all or none. The functional amount is exactly round(original x rate) - proven by the line guard.
  originalCurrency String?  @map("original_currency") @db.Char(3)
  originalDebit    Decimal? @map("original_debit") @db.Decimal(19, 4)
  originalCredit   Decimal? @map("original_credit") @db.Decimal(19, 4)
  rate             Decimal? @db.Decimal(19, 8)
  exchangeRateId   String?  @map("exchange_rate_id") @db.Uuid
  /// A functional-only adjustment (revaluation) that belongs to this foreign-currency balance of the account.
  adjustsCurrency  String?  @map("adjusts_currency") @db.Char(3)
  /// VAT facts (M4b): all or none; a VAT line points at its net line; the database proves the amount at commit.
  taxCodeId        String?   @map("tax_code_id") @db.Uuid
  taxRateId        String?   @map("tax_rate_id") @db.Uuid
  vatRole          String?   @map("vat_role")
  taxPoint         DateTime? @map("tax_point") @db.Date
  vatNetLineNo     Int?      @map("vat_net_line_no")
  vatInclusive     Boolean?  @map("vat_inclusive")
  /// Credit notes (M5a, DEC-029): the tax point of the supply being adjusted; its rate version applies.
  vatRatePoint     DateTime? @map("vat_rate_point") @db.Date

  journal Journal @relation(fields: [journalId], references: [id])

  @@unique([journalId, lineNo])
  @@index([organisationId, companyId, accountId, journalId])
  @@map("journal_line")
}

// ───────────── V1 ledger controls (M2, ADR-49) ─────────────
/// A proposed opening-balance or control-adjustment journal. NOT a ledger entry: it is posted (through the PostingService) only when approved or policy-exempt.
model JournalRequest {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String    @map("organisation_id") @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  kind               String
  status             String    @default("PENDING")
  journalDate        DateTime  @map("journal_date") @db.Date
  description        String
  reason             String
  currency           String    @db.Char(3)
  lines              Json
  total              Decimal   @db.Decimal(19, 4)
  evidenceDocumentIds String[] @default([]) @map("evidence_document_ids") @db.Uuid
  requestedByUserId  String    @map("requested_by_user_id") @db.Uuid
  requestedAt        DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  approvalRequired   Boolean   @map("approval_required")
  selfApproved       Boolean   @default(false) @map("self_approved")
  policySnapshot     Json      @map("policy_snapshot")
  contentHash        String    @map("content_hash")
  decidedByUserId    String?   @map("decided_by_user_id") @db.Uuid
  decidedAt          DateTime? @map("decided_at") @db.Timestamptz(3)
  decisionReason     String?   @map("decision_reason")
  postedJournalId    String?   @map("posted_journal_id") @db.Uuid

  @@unique([organisationId, id])
  @@index([organisationId, companyId, status, requestedAt])
  @@map("journal_request")
}

model LedgerPolicy {
  organisationId           String   @map("organisation_id") @db.Uuid
  companyId                String   @map("company_id") @db.Uuid
  openingBalanceApproval   String   @default("ALWAYS") @map("opening_balance_approval")
  controlAdjustmentApproval String  @default("ALWAYS") @map("control_adjustment_approval")
  materialityThreshold     Decimal? @map("materiality_threshold") @db.Decimal(19, 4)
  requestExpiryDays        Int      @default(14) @map("request_expiry_days")
  updatedByUserId          String?  @map("updated_by_user_id") @db.Uuid
  fxBlockUnverifiedRates   Boolean  @default(false) @map("fx_block_unverified_rates")
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([organisationId, companyId])
  @@map("ledger_policy")
}

// ───────────── V1 foreign-currency foundation (M3, ADR-55) ─────────────
/// Immutable, sourced exchange rate (tenant reference data). Only verification and supersession ever update a row.
model ExchangeRate {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String    @map("organisation_id") @db.Uuid
  fromCurrency       String    @map("from_currency") @db.Char(3)
  toCurrency         String    @map("to_currency") @db.Char(3)
  kind               String
  validFrom          DateTime  @map("valid_from") @db.Date
  validTo            DateTime  @map("valid_to") @db.Date
  rate               Decimal   @db.Decimal(19, 8)
  sourceKind         String    @map("source_kind")
  publisher          String
  series             String?
  sourceUrl          String?   @map("source_url")
  sourceRef          String?   @map("source_ref")
  retrievedAt        DateTime? @map("retrieved_at") @db.Timestamptz(3)
  enteredByUserId    String    @map("entered_by_user_id") @db.Uuid
  importBatchId      String?   @map("import_batch_id") @db.Uuid
  verificationStatus String    @default("UNVERIFIED") @map("verification_status")
  verifiedByUserId   String?   @map("verified_by_user_id") @db.Uuid
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(3)
  supersededById     String?   @map("superseded_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@index([organisationId, fromCurrency, toCurrency, validFrom, validTo])
  @@map("exchange_rate")
}

model CompanyFxSetting {
  organisationId      String   @map("organisation_id") @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  roundingAccountId   String?  @map("rounding_account_id") @db.Uuid
  realisedAccountId   String?  @map("realised_account_id") @db.Uuid
  unrealisedAccountId String?  @map("unrealised_account_id") @db.Uuid
  defaultSeries       Json     @default("{}") @map("default_series")
  updatedByUserId     String?  @map("updated_by_user_id") @db.Uuid
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([organisationId, companyId])
  @@map("company_fx_setting")
}

model FxRevaluationRun {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId       String    @map("organisation_id") @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  periodId             String    @map("period_id") @db.Uuid
  asAtDate             DateTime  @map("as_at_date") @db.Date
  status               String    @default("POSTED")
  revaluationJournalId String    @unique @map("revaluation_journal_id") @db.Uuid
  reversalJournalId    String?   @map("reversal_journal_id") @db.Uuid
  reversalDueDate      DateTime  @map("reversal_due_date") @db.Date
  netAdjustment        Decimal   @map("net_adjustment") @db.Decimal(19, 4)
  rates                Json
  runByUserId          String    @map("run_by_user_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  reversedAt           DateTime? @map("reversed_at") @db.Timestamptz(3)

  @@index([organisationId, companyId, periodId, createdAt])
  @@map("fx_revaluation_run")
}

// ───────────── V1 contact roles (M4a, DEC-011 / DEC-023) ─────────────
model ContactRole {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  contactId       String    @map("contact_id") @db.Uuid
  role            String
  accountCode     String?   @map("account_code")
  status          String    @default("ACTIVE")
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(3)
  endedByUserId   String?   @map("ended_by_user_id") @db.Uuid
  endedReason     String?   @map("ended_reason")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@unique([organisationId, companyId, contactId, role])
  @@index([organisationId, companyId, role, status])
  @@map("contact_role")
}

model CustomerProfile {
  roleId           String   @id @map("role_id") @db.Uuid
  role             String   @default("CUSTOMER")
  organisationId   String   @map("organisation_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  paymentTermsDays Int      @default(30) @map("payment_terms_days")
  creditLimit      Decimal? @map("credit_limit") @db.Decimal(19, 4)
  defaultCurrency  String?  @map("default_currency") @db.Char(3)
  /// DEC-046: copied onto invoice lines that name no VAT code when they are written.
  defaultTaxCodeId String?  @map("default_tax_code_id") @db.Uuid
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("customer_profile")
}

/// Bank details are field-level encrypted (`bankDetailsEnc`); only `bankDetailsMasked` ever leaves the service in lists and audit records.
model SupplierProfile {
  roleId                      String    @id @map("role_id") @db.Uuid
  role                        String    @default("SUPPLIER")
  organisationId              String    @map("organisation_id") @db.Uuid
  companyId                   String    @map("company_id") @db.Uuid
  paymentTermsDays            Int       @default(30) @map("payment_terms_days")
  defaultCurrency             String?   @map("default_currency") @db.Char(3)
  defaultExpenseAccountId     String?   @map("default_expense_account_id") @db.Uuid
  bankDetailsEnc              String?   @map("bank_details_enc")
  bankDetailsMasked           String?   @map("bank_details_masked")
  bankDetailsStatus           String    @default("NONE") @map("bank_details_status")
  bankDetailsChangedByUserId  String?   @map("bank_details_changed_by_user_id") @db.Uuid
  bankDetailsChangedAt        DateTime? @map("bank_details_changed_at") @db.Timestamptz(3)
  bankDetailsVerifiedByUserId String?   @map("bank_details_verified_by_user_id") @db.Uuid
  bankDetailsVerifiedAt       DateTime? @map("bank_details_verified_at") @db.Timestamptz(3)
  updatedAt                   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("supplier_profile")
}

// ───────────── V1 VAT foundation (M4b, DEC-010 / DEC-021) ─────────────
model TaxCode {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  code            String
  name            String
  treatment       String
  direction       String
  reverseCharge   Boolean  @default(false) @map("reverse_charge")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@unique([organisationId, code])
  @@map("tax_code")
}

/// A sourced, effective-dated rate version; unusable until VERIFIED by someone other than its author (DEC-021).
model TaxRate {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String    @map("organisation_id") @db.Uuid
  taxCodeId          String    @map("tax_code_id") @db.Uuid
  rate               Decimal   @db.Decimal(7, 4)
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  netBoxes           Int[]     @default([]) @map("net_boxes") @db.SmallInt
  vatBoxes           Int[]     @default([]) @map("vat_boxes") @db.SmallInt
  sourceUrl          String    @map("source_url")
  sourceProvision    String    @map("source_provision")
  sourceRetrievedOn  DateTime  @map("source_retrieved_on") @db.Date
  enteredByUserId    String    @map("entered_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  verificationStatus String    @default("UNVERIFIED") @map("verification_status")
  verifiedByUserId   String?   @map("verified_by_user_id") @db.Uuid
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(3)
  verificationNotes  String?   @map("verification_notes")
  evidenceDocumentId String?   @map("evidence_document_id") @db.Uuid
  supersededById     String?   @map("superseded_by_id") @db.Uuid

  @@unique([organisationId, id])
  @@index([organisationId, taxCodeId, effectiveFrom])
  @@map("tax_rate")
}

model CompanyVatSetting {
  organisationId  String    @map("organisation_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  registered      Boolean   @default(false)
  vrn             String?
  registeredFrom  DateTime? @map("registered_from") @db.Date
  scheme          String    @default("STANDARD")
  periodMonths    Int       @default(3) @map("period_months") @db.SmallInt
  anchorPeriodEnd DateTime? @map("anchor_period_end") @db.Date
  outputAccountId String?   @map("output_account_id") @db.Uuid
  inputAccountId  String?   @map("input_account_id") @db.Uuid
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([organisationId, companyId])
  @@map("company_vat_setting")
}

/// Sales settings (M5a, DEC-027): receivables control account, numbering (frozen once a document of the kind is numbered), separation of duties.
model SalesSetting {
  organisationId          String   @map("organisation_id") @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  receivablesAccountId    String?  @map("receivables_account_id") @db.Uuid
  invoicePrefix           String   @default("INV-") @map("invoice_prefix")
  creditNotePrefix        String   @default("CN-") @map("credit_note_prefix")
  invoiceStart            Int      @default(1) @map("invoice_start")
  creditNoteStart         Int      @default(1) @map("credit_note_start")
  requireSeparateApprover Boolean  @default(false) @map("require_separate_approver")
  updatedByUserId         String?  @map("updated_by_user_id") @db.Uuid
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([organisationId, companyId])
  @@map("sales_setting")
}

/// Last number issued per company and kind; moves forward by one in the approval transaction (no gaps).
model SalesSequence {
  organisationId String @map("organisation_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid
  kind           String
  lastNumber     Int    @map("last_number")

  @@id([organisationId, companyId, kind])
  @@map("sales_sequence")
}

/// Invoices and credit notes (M5a). DRAFT -> APPROVED (numbered, posted, immutable) | DISCARDED. Outstanding amounts move only through allocations.
model SalesDocument {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId            String    @map("organisation_id") @db.Uuid
  companyId                 String    @map("company_id") @db.Uuid
  kind                      String
  status                    String    @default("DRAFT")
  number                    Int?
  documentNumber            String?   @map("document_number")
  customerRoleId            String    @map("customer_role_id") @db.Uuid
  partyRole                 String    @default("CUSTOMER") @map("party_role")
  contactId                 String    @map("contact_id") @db.Uuid
  issueDate                 DateTime  @map("issue_date") @db.Date
  supplyDate                DateTime? @map("supply_date") @db.Date
  taxPoint                  DateTime? @map("tax_point") @db.Date
  dueDate                   DateTime  @map("due_date") @db.Date
  currency                  String    @db.Char(3)
  amountsIncludeVat         Boolean   @default(false) @map("amounts_include_vat")
  customerReference         String?   @map("customer_reference")
  notes                     String?
  originalInvoiceId         String?   @map("original_invoice_id") @db.Uuid
  creditReason              String?   @map("credit_reason")
  revision                  Int       @default(1)
  netTotal                  Decimal   @default(0) @map("net_total") @db.Decimal(19, 4)
  vatTotal                  Decimal   @default(0) @map("vat_total") @db.Decimal(19, 4)
  grossTotal                Decimal   @default(0) @map("gross_total") @db.Decimal(19, 4)
  outstanding               Decimal   @default(0) @db.Decimal(19, 4)
  functionalGross           Decimal?  @map("functional_gross") @db.Decimal(19, 4)
  functionalOutstanding     Decimal   @default(0) @map("functional_outstanding") @db.Decimal(19, 4)
  exchangeRateId            String?   @map("exchange_rate_id") @db.Uuid
  rate                      Decimal?  @db.Decimal(19, 8)
  journalId                 String?   @map("journal_id") @db.Uuid
  contactSnapshot           Json?     @map("contact_snapshot")
  duplicateOverrideReason   String?   @map("duplicate_override_reason")
  creditLimitOverrideReason String?   @map("credit_limit_override_reason")
  origin                    String    @default("MANUAL")
  aiProposalId              String?   @map("ai_proposal_id") @db.Uuid
  createdByUserId           String    @map("created_by_user_id") @db.Uuid
  approvedByUserId          String?   @map("approved_by_user_id") @db.Uuid
  approvedAt                DateTime? @map("approved_at") @db.Timestamptz(3)
  discardedByUserId         String?   @map("discarded_by_user_id") @db.Uuid
  discardedAt               DateTime? @map("discarded_at") @db.Timestamptz(3)
  discardedReason           String?   @map("discarded_reason")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@index([organisationId, companyId, kind, status, issueDate], map: "sales_document_company_idx")
  @@index([organisationId, companyId, customerRoleId, status], map: "sales_document_customer_idx")
  @@map("sales_document")
}

/// Append-only line revisions of a sales document; the current revision is the document's `revision`.
model SalesDocumentLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  revision       Int
  lineNo         Int      @map("line_no")
  description    String
  quantity       Decimal  @db.Decimal(18, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(19, 4)
  accountId      String   @map("account_id") @db.Uuid
  taxCodeId      String?  @map("tax_code_id") @db.Uuid
  net            Decimal  @db.Decimal(19, 4)
  vat            Decimal  @db.Decimal(19, 4)
  gross          Decimal  @db.Decimal(19, 4)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([documentId, revision, lineNo], map: "sales_document_line_key")
  @@index([organisationId, documentId, revision], map: "sales_document_line_org_idx")
  @@map("sales_document_line")
}

/// A credit applied to an invoice (DEC-030): immutable; the database moves both outstanding amounts and refuses a negative balance.
model SalesAllocation {
  id                String   @id @db.Uuid
  organisationId    String   @map("organisation_id") @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  invoiceId         String   @map("invoice_id") @db.Uuid
  creditId          String?  @map("credit_id") @db.Uuid
  /// M5b: a receipt applied instead of a credit note (exactly one of the two).
  receiptId         String?  @map("receipt_id") @db.Uuid
  amount            Decimal  @db.Decimal(19, 4)
  invoiceFunctional Decimal  @map("invoice_functional") @db.Decimal(19, 4)
  creditFunctional  Decimal  @map("credit_functional") @db.Decimal(19, 4)
  fxDifference      Decimal  @map("fx_difference") @db.Decimal(19, 4)
  fxJournalId       String?  @map("fx_journal_id") @db.Uuid
  allocatedOn       DateTime @map("allocated_on") @db.Date
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@index([organisationId, invoiceId], map: "sales_allocation_invoice_idx")
  @@index([organisationId, creditId], map: "sales_allocation_credit_idx")
  @@map("sales_allocation")
}

/// Customer receipts (M5b, DEC-032): posted when recorded; outstanding (unallocated) amounts move only through allocations; reversed only while unallocated.
model SalesReceipt {
  id                      String    @id @db.Uuid
  organisationId          String    @map("organisation_id") @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  customerRoleId          String    @map("customer_role_id") @db.Uuid
  partyRole               String    @default("CUSTOMER") @map("party_role")
  contactId               String    @map("contact_id") @db.Uuid
  receiptDate             DateTime  @map("receipt_date") @db.Date
  currency                String    @db.Char(3)
  amount                  Decimal   @db.Decimal(19, 4)
  outstanding             Decimal   @db.Decimal(19, 4)
  functionalAmount        Decimal   @map("functional_amount") @db.Decimal(19, 4)
  functionalOutstanding   Decimal   @map("functional_outstanding") @db.Decimal(19, 4)
  bankAccountId           String    @map("bank_account_id") @db.Uuid
  exchangeRateId          String?   @map("exchange_rate_id") @db.Uuid
  rate                    Decimal?  @db.Decimal(19, 8)
  reference               String?
  notes                   String?
  journalId               String    @map("journal_id") @db.Uuid
  duplicateOverrideReason String?   @map("duplicate_override_reason")
  status                  String    @default("POSTED")
  reversalJournalId       String?   @map("reversal_journal_id") @db.Uuid
  reversedByUserId        String?   @map("reversed_by_user_id") @db.Uuid
  reversedAt              DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedReason          String?   @map("reversed_reason")
  createdByUserId         String    @map("created_by_user_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@index([organisationId, companyId, customerRoleId, status], map: "sales_receipt_customer_idx")
  @@index([organisationId, companyId, receiptDate], map: "sales_receipt_date_idx")
  @@map("sales_receipt")
}

/// Purchase settings (M6a, DEC-033/034): payables control account, numbering (frozen once a document of the kind is numbered), separation of duties.
model PurchaseSetting {
  organisationId          String   @map("organisation_id") @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  payablesAccountId    String?  @map("payables_account_id") @db.Uuid
  billPrefix              String   @default("BILL-") @map("bill_prefix")
  debitNotePrefix         String   @default("DN-") @map("debit_note_prefix")
  billStart               Int      @default(1) @map("bill_start")
  debitNoteStart          Int      @default(1) @map("debit_note_start")
  requireSeparateApprover Boolean  @default(false) @map("require_separate_approver")
  updatedByUserId         String?  @map("updated_by_user_id") @db.Uuid
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([organisationId, companyId])
  @@map("purchase_setting")
}

/// Last number issued per company and kind; moves forward by one in the approval transaction (no gaps).
model PurchaseSequence {
  organisationId String @map("organisation_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid
  kind           String
  lastNumber     Int    @map("last_number")

  @@id([organisationId, companyId, kind])
  @@map("purchase_sequence")
}

/// Bills and debit notes (M6a). DRAFT -> APPROVED (numbered, posted, immutable) | DISCARDED. Outstanding amounts move only through allocations.
model PurchaseDocument {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId            String    @map("organisation_id") @db.Uuid
  companyId                 String    @map("company_id") @db.Uuid
  kind                      String
  status                    String    @default("DRAFT")
  number                    Int?
  documentNumber            String?   @map("document_number")
  supplierRoleId            String    @map("supplier_role_id") @db.Uuid
  partyRole                 String    @default("SUPPLIER") @map("party_role")
  contactId                 String    @map("contact_id") @db.Uuid
  issueDate                 DateTime  @map("issue_date") @db.Date
  supplyDate                DateTime? @map("supply_date") @db.Date
  taxPoint                  DateTime? @map("tax_point") @db.Date
  dueDate                   DateTime  @map("due_date") @db.Date
  currency                  String    @db.Char(3)
  amountsIncludeVat         Boolean   @default(false) @map("amounts_include_vat")
  supplierReference         String?   @map("supplier_reference")
  notes                     String?
  originalBillId         String?   @map("original_bill_id") @db.Uuid
  debitReason              String?   @map("debit_reason")
  revision                  Int       @default(1)
  netTotal                  Decimal   @default(0) @map("net_total") @db.Decimal(19, 4)
  vatTotal                  Decimal   @default(0) @map("vat_total") @db.Decimal(19, 4)
  grossTotal                Decimal   @default(0) @map("gross_total") @db.Decimal(19, 4)
  outstanding               Decimal   @default(0) @db.Decimal(19, 4)
  functionalGross           Decimal?  @map("functional_gross") @db.Decimal(19, 4)
  functionalOutstanding     Decimal   @default(0) @map("functional_outstanding") @db.Decimal(19, 4)
  exchangeRateId            String?   @map("exchange_rate_id") @db.Uuid
  rate                      Decimal?  @db.Decimal(19, 8)
  journalId                 String?   @map("journal_id") @db.Uuid
  contactSnapshot           Json?     @map("contact_snapshot")
  duplicateOverrideReason   String?   @map("duplicate_override_reason")
  origin                    String    @default("MANUAL")
  aiProposalId              String?   @map("ai_proposal_id") @db.Uuid
  createdByUserId           String    @map("created_by_user_id") @db.Uuid
  approvedByUserId          String?   @map("approved_by_user_id") @db.Uuid
  approvedAt                DateTime? @map("approved_at") @db.Timestamptz(3)
  discardedByUserId         String?   @map("discarded_by_user_id") @db.Uuid
  discardedAt               DateTime? @map("discarded_at") @db.Timestamptz(3)
  discardedReason           String?   @map("discarded_reason")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@index([organisationId, companyId, kind, status, issueDate], map: "purchase_document_company_idx")
  @@index([organisationId, companyId, supplierRoleId, status], map: "purchase_document_supplier_idx")
  @@map("purchase_document")
}

/// Append-only line revisions of a purchase document; the current revision is the document's `revision`.
model PurchaseDocumentLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  revision       Int
  lineNo         Int      @map("line_no")
  description    String
  quantity       Decimal  @db.Decimal(18, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(19, 4)
  accountId      String   @map("account_id") @db.Uuid
  taxCodeId      String?  @map("tax_code_id") @db.Uuid
  net            Decimal  @db.Decimal(19, 4)
  vat            Decimal  @db.Decimal(19, 4)
  gross          Decimal  @db.Decimal(19, 4)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([documentId, revision, lineNo], map: "purchase_document_line_key")
  @@index([organisationId, documentId, revision], map: "purchase_document_line_org_idx")
  @@map("purchase_document_line")
}

/// A debit note applied to its bill (DEC-030): immutable; the database moves both outstanding amounts and refuses a negative balance.
model PurchaseAllocation {
  id                String   @id @db.Uuid
  organisationId    String   @map("organisation_id") @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  billId         String   @map("bill_id") @db.Uuid
  debitId           String?  @map("debit_id") @db.Uuid
  /// M6b: a payment applied instead of a debit note (exactly one of the two).
  paymentId         String?  @map("payment_id") @db.Uuid
  amount            Decimal  @db.Decimal(19, 4)
  billFunctional Decimal  @map("bill_functional") @db.Decimal(19, 4)
  debitFunctional  Decimal  @map("debit_functional") @db.Decimal(19, 4)
  fxDifference      Decimal  @map("fx_difference") @db.Decimal(19, 4)
  fxJournalId       String?  @map("fx_journal_id") @db.Uuid
  allocatedOn       DateTime @map("allocated_on") @db.Date
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@index([organisationId, billId], map: "purchase_allocation_bill_idx")
  @@index([organisationId, debitId], map: "purchase_allocation_debit_idx")
  @@map("purchase_allocation")
}

/// Supplier payments (M6b, DEC-035): posted when recorded; outstanding (unallocated) amounts move only through allocations; reversed only while unallocated.
model PurchasePayment {
  id                      String    @id @db.Uuid
  organisationId          String    @map("organisation_id") @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  supplierRoleId          String    @map("supplier_role_id") @db.Uuid
  partyRole               String    @default("SUPPLIER") @map("party_role")
  contactId               String    @map("contact_id") @db.Uuid
  paymentDate             DateTime  @map("payment_date") @db.Date
  currency                String    @db.Char(3)
  amount                  Decimal   @db.Decimal(19, 4)
  outstanding             Decimal   @db.Decimal(19, 4)
  functionalAmount        Decimal   @map("functional_amount") @db.Decimal(19, 4)
  functionalOutstanding   Decimal   @map("functional_outstanding") @db.Decimal(19, 4)
  bankAccountId           String    @map("bank_account_id") @db.Uuid
  exchangeRateId          String?   @map("exchange_rate_id") @db.Uuid
  rate                    Decimal?  @db.Decimal(19, 8)
  reference               String?
  notes                   String?
  journalId               String    @map("journal_id") @db.Uuid
  duplicateOverrideReason String?   @map("duplicate_override_reason")
  /// DEC-035: the stored bank details were UNVERIFIED when this payment was recorded.
  bankDetailsUnverified   Boolean   @default(false) @map("bank_details_unverified")
  status                  String    @default("POSTED")
  reversalJournalId       String?   @map("reversal_journal_id") @db.Uuid
  reversedByUserId        String?   @map("reversed_by_user_id") @db.Uuid
  reversedAt              DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedReason          String?   @map("reversed_reason")
  createdByUserId         String    @map("created_by_user_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@index([organisationId, companyId, supplierRoleId, status], map: "purchase_payment_supplier_idx")
  @@index([organisationId, companyId, paymentDate], map: "purchase_payment_date_idx")
  @@map("purchase_payment")
}

/// M6c (DEC-036, DEC-037): money in or out of a bank or cash account without a source document. Posted when recorded; immutable; reversed only by
/// its own mirror journal. Written only by CashService.
model CashTransaction {
  id                      String    @id @db.Uuid
  organisationId          String    @map("organisation_id") @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  direction               String
  transactionDate         DateTime  @map("transaction_date") @db.Date
  taxPoint                DateTime? @map("tax_point") @db.Date
  bankAccountId           String    @map("bank_account_id") @db.Uuid
  contactId               String?   @map("contact_id") @db.Uuid
  counterparty            String?
  reference               String?
  description             String
  currency                String    @db.Char(3)
  amountsIncludeVat       Boolean   @default(false) @map("amounts_include_vat")
  netTotal                Decimal   @map("net_total") @db.Decimal(19, 4)
  vatTotal                Decimal   @map("vat_total") @db.Decimal(19, 4)
  grossTotal              Decimal   @map("gross_total") @db.Decimal(19, 4)
  journalId               String    @map("journal_id") @db.Uuid
  duplicateOverrideReason String?   @map("duplicate_override_reason")
  status                  String    @default("POSTED")
  reversalJournalId       String?   @map("reversal_journal_id") @db.Uuid
  reversedByUserId        String?   @map("reversed_by_user_id") @db.Uuid
  reversedAt              DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedReason          String?   @map("reversed_reason")
  createdByUserId         String    @map("created_by_user_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@index([organisationId, companyId, bankAccountId, transactionDate], map: "cash_transaction_account_idx")
  @@index([organisationId, companyId, transactionDate], map: "cash_transaction_date_idx")
  @@map("cash_transaction")
}

model CashTransactionLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  transactionId  String   @map("transaction_id") @db.Uuid
  lineNo         Int      @map("line_no")
  description    String
  accountId      String   @map("account_id") @db.Uuid
