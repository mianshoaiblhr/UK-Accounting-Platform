/// Global (auth subsystem only): IP addresses a user has successfully signed in from. Used so that a
/// distributed password-guessing attack on an account cannot lock out the real owner's usual locations.
model LoginTrustedIp {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  ipHash        String   @map("ip_hash")
  lastSuccessAt DateTime @default(now()) @map("last_success_at") @db.Timestamptz(3)

  @@unique([userId, ipHash])
  @@map("login_trusted_ip")
}

// ───────────── Transactional outbox ─────────────
model OutboxEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType      String       @map("event_type")
  eventVersion   Int          @default(1) @map("event_version")
  aggregateType  String       @map("aggregate_type")
  aggregateId    String       @map("aggregate_id")
  organisationId String?      @map("organisation_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  payload        Json
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  correlationId  String       @map("correlation_id")
  causationId    String?      @map("causation_id")
  /// Optional business idempotency key: publishing the same key twice stores one event.
  idempotencyKey String?      @unique @map("idempotency_key")
  status         OutboxStatus @default(PENDING)
  retryCount     Int          @default(0) @map("retry_count")
  lastError      String?      @map("last_error")
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Insertion sequence (identity). Per-aggregate order == business order.
  seq            BigInt       @unique @default(autoincrement())
  /// Set when every consumer has completed. The relay publishes only an aggregate's head (no earlier unprocessed event).
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([organisationId, occurredAt(sort: Desc)])
  @@map("outbox_event")
}

/// Consumer-side idempotency: (event, consumer) is processed at most once to completion.
model EventConsumption {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  consumer       String
  organisationId String?  @map("organisation_id") @db.Uuid
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@unique([eventId, consumer])
  @@map("event_consumption")
}

// ───────────── Workflow / tasks / notifications ─────────────
model WorkflowInstance {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  companyId         String?   @map("company_id") @db.Uuid
  type              String
  definitionVersion Int       @map("definition_version")
  state             String
  subjectType       String    @map("subject_type")
  subjectId         String    @map("subject_id")
  context           Json      @default("{}")
  /// Optimistic concurrency token.
  version           Int       @default(1)
  startedByUserId   String    @map("started_by_user_id") @db.Uuid
  assigneeUserId    String?   @map("assignee_user_id") @db.Uuid
  /// Increments each time a rejected instance is reopened (retry).
  attempt           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)

  transitions WorkflowTransition[]

  @@unique([organisationId, id])
  @@index([organisationId, type, state])
  @@index([organisationId, subjectType, subjectId])
  @@map("workflow_instance")
}

/// Append-only history of every state change.
model WorkflowTransition {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String   @map("organisation_id") @db.Uuid
  instanceId          String   @map("instance_id") @db.Uuid
  fromState           String?  @map("from_state")
  toState             String   @map("to_state")
  action              String
  actorUserId         String?  @map("actor_user_id") @db.Uuid
  comment             String?
  attempt             Int      @default(1)
  /// Documents offered as evidence for this transition (validated to the same organisation/company).
  evidenceDocumentIds String[] @default([]) @map("evidence_document_ids") @db.Uuid
  occurredAt          DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  instance WorkflowInstance @relation(fields: [organisationId, instanceId], references: [organisationId, id], onDelete: Cascade)

  @@index([instanceId, occurredAt])
  @@map("workflow_transition")
}

model Task {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String       @map("organisation_id") @db.Uuid
  /// Composite FK (organisation_id, company_id) -> company.
  companyId       String?      @map("company_id") @db.Uuid
  title           String
  description     String       @default("")
  status          TaskStatus   @default(OPEN)
  priority        TaskPriority @default(NORMAL)
  dueDate         DateTime?    @map("due_date") @db.Date
  assigneeUserId  String?      @map("assignee_user_id") @db.Uuid
  /// Optional reviewer (never the assignee). With a reviewer the task is completed only from IN_REVIEW and only by that user.
  reviewerUserId  String?      @map("reviewer_user_id") @db.Uuid
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  /// What created the task: MANUAL | WORKFLOW | AI_PROPOSAL | DOCUMENT | EVENT | SYSTEM.
  source          String       @default("MANUAL")
  sourceId        String?      @map("source_id")
  subjectType     String?      @map("subject_type")
  subjectId       String?      @map("subject_id")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(3)

  attachments TaskAttachment[]
  comments    TaskComment[]
  reminders   TaskReminder[]

  @@unique([organisationId, id])
  @@index([organisationId, status])
  @@index([organisationId, assigneeUserId])
  @@index([organisationId, reviewerUserId])
  @@index([organisationId, companyId])
  @@map("task")
}

/// Link between a task and a document of the same company (trigger-enforced).
model TaskAttachment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  addedByUserId  String   @map("added_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task Task @relation(fields: [organisationId, taskId], references: [organisationId, id], onDelete: Cascade)

  @@unique([taskId, documentId])
  @@index([organisationId, documentId])
  @@map("task_attachment")
}

/// Append-only (trigger-enforced).
model TaskComment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  authorUserId   String   @map("author_user_id") @db.Uuid
  body           String
  /// COMMENT | REVIEW_APPROVED | REVIEW_RETURNED
  kind           String   @default("COMMENT")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task Task @relation(fields: [organisationId, taskId], references: [organisationId, id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comment")
}

/// Pending -> sent | cancelled exactly once (trigger-enforced); delivered by the worker sweeper.
model TaskReminder {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  taskId          String    @map("task_id") @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  remindAt        DateTime  @map("remind_at") @db.Timestamptz(3)
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(3)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// Delivery bookkeeping: failures are counted and backed off; after the limit the reminder is cancelled with last_error set.
  attempts        Int       @default(0)
  lastError       String?   @map("last_error")
  retryAt         DateTime? @map("retry_at") @db.Timestamptz(3)

  task Task @relation(fields: [organisationId, taskId], references: [organisationId, id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_reminder")
}

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
