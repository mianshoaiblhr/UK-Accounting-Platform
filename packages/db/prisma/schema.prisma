  vat            Decimal  @db.Decimal(19, 4)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([transactionId, lineNo], map: "cash_transaction_line_no_key")
  @@index([organisationId, companyId, transactionId], map: "cash_transaction_line_org_idx")
  @@map("cash_transaction_line")
}

/// M7a (DEC-039): what the bank knows about a CURRENT_ASSET_BANK ledger account. Written only by BankService (accounting).
model BankAccount {
  id                        String    @id @db.Uuid
  organisationId            String    @map("organisation_id") @db.Uuid
  companyId                 String    @map("company_id") @db.Uuid
  accountId                 String    @unique(map: "bank_account_ledger_account_key") @map("account_id") @db.Uuid
  name                      String
  bankName                  String?   @map("bank_name")
  currency                  String    @db.Char(3)
  accountDetailsEnc         String?   @map("account_details_enc")
  accountDetailsMasked      String?   @map("account_details_masked")
  statementOpeningDate      DateTime  @map("statement_opening_date") @db.Date
  statementOpeningBalance   Decimal   @default(0) @map("statement_opening_balance") @db.Decimal(19, 4)
  chargesAccountId          String?   @map("charges_account_id") @db.Uuid
  interestReceivedAccountId String?   @map("interest_received_account_id") @db.Uuid
  interestPaidAccountId     String?   @map("interest_paid_account_id") @db.Uuid
  status                    String    @default("ACTIVE")
  closedAt                  DateTime? @map("closed_at") @db.Timestamptz(3)
  closedByUserId            String?   @map("closed_by_user_id") @db.Uuid
  closedReason              String?   @map("closed_reason")
  createdByUserId           String    @map("created_by_user_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@unique([organisationId, companyId, id], map: "bank_account_company_id_id_key")
  @@index([organisationId, companyId, status], map: "bank_account_company_idx")
  @@map("bank_account")
}

/// M7a (DEC-040, ADR-61): one CSV statement imported into one bank account. Written only by the statement importer (platform).
model BankStatementImport {
  id                      String    @id @db.Uuid
  organisationId          String    @map("organisation_id") @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  bankAccountId           String    @map("bank_account_id") @db.Uuid
  documentId              String    @map("document_id") @db.Uuid
  documentVersionId       String    @map("document_version_id") @db.Uuid
  fileSha256              String    @map("file_sha256") @db.Char(64)
  mapping                 Json
  status                  String    @default("QUEUED")
  jobId                   String?   @map("job_id") @db.Uuid
  rowsRead                Int?      @map("rows_read")
  rowsImported            Int?      @map("rows_imported")
  rowsDuplicate           Int?      @map("rows_duplicate")
  errors                  Json?
  firstDate               DateTime? @map("first_date") @db.Date
  lastDate                DateTime? @map("last_date") @db.Date
  openingBalance          Decimal?  @map("opening_balance") @db.Decimal(19, 4)
  closingBalance          Decimal?  @map("closing_balance") @db.Decimal(19, 4)
  duplicateOverrideReason String?   @map("duplicate_override_reason")
  requestedByUserId       String    @map("requested_by_user_id") @db.Uuid
  requestedAt             DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  completedAt             DateTime? @map("completed_at") @db.Timestamptz(3)
  voidedByUserId          String?   @map("voided_by_user_id") @db.Uuid
  voidedAt                DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason              String?   @map("void_reason")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@index([organisationId, bankAccountId, requestedAt], map: "bank_statement_import_account_idx")
  @@index([organisationId, bankAccountId, fileSha256], map: "bank_statement_import_sha_idx")
  @@map("bank_statement_import")
}

/// M7a (DEC-040): a line of a bank statement - a fact from the bank, never edited. Signed amount in the account currency (+ money in).
model BankStatementLine {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  bankAccountId   String   @map("bank_account_id") @db.Uuid
  importId        String   @map("import_id") @db.Uuid
  lineNo          Int      @map("line_no")
  sourceRow       Int      @map("source_row")
  transactionDate DateTime @map("transaction_date") @db.Date
  description     String
  reference       String?
  amount          Decimal  @db.Decimal(19, 4)
  balance         Decimal? @db.Decimal(19, 4)
  fingerprint     String   @db.Char(64)
  matchedAmount   Decimal  @default(0) @map("matched_amount") @db.Decimal(19, 4)
  voided          Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@unique([importId, lineNo], map: "bank_statement_line_no_key")
  @@index([organisationId, bankAccountId, transactionDate], map: "bank_statement_line_account_idx")
  @@map("bank_statement_line")
}

/// M7a (DEC-041): money moved between two bank or cash accounts of the company, one balanced journal. Written only by BankService.
model BankTransfer {
  id                      String    @id @db.Uuid
  organisationId          String    @map("organisation_id") @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  fromAccountId           String    @map("from_account_id") @db.Uuid
  toAccountId             String    @map("to_account_id") @db.Uuid
  transferDate            DateTime  @map("transfer_date") @db.Date
  currency                String    @db.Char(3)
  amount                  Decimal   @db.Decimal(19, 4)
  reference               String?
  description             String
  journalId               String    @map("journal_id") @db.Uuid
  duplicateOverrideReason String?   @map("duplicate_override_reason")
  status                  String    @default("POSTED")
  reversalJournalId       String?   @map("reversal_journal_id") @db.Uuid
  reversedByUserId        String?   @map("reversed_by_user_id") @db.Uuid
  reversedAt              DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedReason          String?   @map("reversed_reason")
  createdByUserId         String    @map("created_by_user_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@index([organisationId, companyId, transferDate], map: "bank_transfer_date_idx")
  @@map("bank_transfer")
}

/// M7b (DEC-042): a statement line matched to a ledger entry on the bank account. Never edited; undone with a reason. Written only by ReconciliationService.
model BankMatch {
  id                String    @id @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  bankAccountId     String    @map("bank_account_id") @db.Uuid
  statementLineId   String    @map("statement_line_id") @db.Uuid
  journalLineId     String    @map("journal_line_id") @db.Uuid
  journalId         String    @map("journal_id") @db.Uuid
  amount            Decimal   @db.Decimal(19, 4)
  kind              String
  overrideReason    String?   @map("override_reason")
  status            String    @default("ACTIVE")
  unmatchedByUserId String?   @map("unmatched_by_user_id") @db.Uuid
  unmatchedAt       DateTime? @map("unmatched_at") @db.Timestamptz(3)
  unmatchReason     String?   @map("unmatch_reason")
  afterSignOff      Boolean   @default(false) @map("after_sign_off")
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@index([organisationId, statementLineId], map: "bank_match_line_idx")
  @@index([organisationId, journalLineId], map: "bank_match_journal_line_idx")
  @@index([organisationId, bankAccountId, status], map: "bank_match_account_idx")
  @@map("bank_match")
}

/// M7b (DEC-042): a signed-off bank reconciliation - the proved figures as at a date, recorded once.
model BankReconciliation {
  id                      String   @id @db.Uuid
  organisationId          String   @map("organisation_id") @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  bankAccountId           String   @map("bank_account_id") @db.Uuid
  asAt                    DateTime @map("as_at") @db.Date
  bankClosingBalance      Decimal  @map("bank_closing_balance") @db.Decimal(19, 4)
  statementBalance        Decimal  @map("statement_balance") @db.Decimal(19, 4)
  ledgerBalance           Decimal  @map("ledger_balance") @db.Decimal(19, 4)
  unmatchedStatement      Decimal  @map("unmatched_statement") @db.Decimal(19, 4)
  unmatchedLedger         Decimal  @map("unmatched_ledger") @db.Decimal(19, 4)
  difference              Decimal  @db.Decimal(19, 4)
  unmatchedStatementLines Int      @map("unmatched_statement_lines")
  unmatchedLedgerLines    Int      @map("unmatched_ledger_lines")
  notes                   String?
  signedByUserId          String   @map("signed_by_user_id") @db.Uuid
  signedAt                DateTime @default(now()) @map("signed_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@index([organisationId, bankAccountId, asAt], map: "bank_reconciliation_account_idx")
  @@map("bank_reconciliation")
}

/// V2-M1 (DEC-053): an accounting standard a firm reports under (FRS105, FRS102-1A, ...). Content lives in its versions; nothing is seeded (DEC-052).
model ReportingStandard {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  code            String
  name            String
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@unique([organisationId, code])
  @@map("reporting_standard")
}

/// V2-M1 (DEC-052): an effective-dated, sourced version of a standard, verified by a second person; immutable once verified, superseded by a new version.
model ReportingStandardVersion {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  standardId        String    @map("standard_id") @db.Uuid
  label             String
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date
  sourceUrl         String    @map("source_url")
  sourceReference   String    @map("source_reference")
  sourceRetrievedOn DateTime  @map("source_retrieved_on") @db.Date
  notes             String?
  status            String    @default("UNVERIFIED")
  copiedFromId      String?   @map("copied_from_id") @db.Uuid
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  verifiedByUserId  String?   @map("verified_by_user_id") @db.Uuid
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(3)
  verificationNotes String?   @map("verification_notes")
  supersededById    String?   @map("superseded_by_id") @db.Uuid

  @@unique([organisationId, id], map: "rsv_organisation_id_id_key")
  @@index([organisationId, standardId, effectiveFrom], map: "rsv_standard_idx")
  @@map("reporting_standard_version")
}

/// V2-M1: a line of a statutory statement in one version: fed by accounts through the map, a signed total of other lines, or the retained profit.
model StatutoryLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  key            String
  statement      String
  parentKey      String?  @map("parent_key")
  sort           Int      @default(0)
  name           String
  kind           String
  naturalSide    String?  @map("natural_side")
  formula        Json?
  removed        Boolean  @default(false)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@map("statutory_line")
}

/// V2-M1: which V1 reporting line (optionally narrowed by account subtype) feeds which statutory line in one version; the most specific entry wins.
model StatutoryMapEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  sourceLine     String   @map("source_line")
  accountSubtype String?  @map("account_subtype")
  targetKey      String   @map("target_key")
  removed        Boolean  @default(false)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@map("statutory_map_entry")
}

/// V2-M1: a validation rule of one version, an expression in the closed grammar (v2-plan 3.3).
model ValidationRule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  key            String
  description    String
  severity       String   @default("ERROR")
  appliesTo      String[] @default(["MICRO", "SMALL", "MEDIUM", "LARGE"]) @map("applies_to")
  expression     Json
  removed        Boolean  @default(false)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@map("validation_rule")
}

/// V2-M1: a disclosure (note) a version requires: the lines and facts it needs. Stored and shape-checked here; rendered in V2-M5.
model DisclosureRule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  key            String
  title          String
  appliesTo      String[] @default(["MICRO", "SMALL", "MEDIUM", "LARGE"]) @map("applies_to")
  requires       Json     @default("{}")
  removed        Boolean  @default(false)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, id])
  @@map("disclosure_rule")
}

/// V2-M1: a company's own placement of one account on a statutory line of a version, with a reason; ended, never edited or deleted.
model StatutoryAccountOverride {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  versionId       String    @map("version_id") @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  targetKey       String    @map("target_key")
  reason          String
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(3)
  endedByUserId   String?   @map("ended_by_user_id") @db.Uuid
  endedReason     String?   @map("ended_reason")

  @@unique([organisationId, id], map: "sao_organisation_id_id_key")
  @@map("statutory_account_override")
}

/// V2-M1: the standard version and entity size a company reports under for one financial year (audited; locked once approved, V2-M6).
model CompanyReportingFramework {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  yearStart      DateTime  @map("year_start") @db.Date
  yearEnd        DateTime  @map("year_end") @db.Date
  versionId      String    @map("version_id") @db.Uuid
  entitySize     String    @map("entity_size")
  reason         String
  chosenByUserId String    @map("chosen_by_user_id") @db.Uuid
  chosenAt       DateTime  @default(now()) @map("chosen_at") @db.Timestamptz(3)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(3)

  @@unique([organisationId, id], map: "crf_organisation_id_id_key")
  @@unique([organisationId, companyId, yearStart], map: "crf_company_year_key")
  @@map("company_reporting_framework")
}
