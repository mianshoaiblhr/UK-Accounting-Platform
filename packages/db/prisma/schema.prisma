/// Append-only. organisation_id NULL for pre-tenant events (login etc.).
model AuditEvent {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt       DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  organisationId   String?      @map("organisation_id") @db.Uuid
  /// Company the event concerns; the audit trail is filtered by the reader's per-company access.
  companyId        String?      @map("company_id") @db.Uuid
  actorUserId      String?      @map("actor_user_id") @db.Uuid
  action           String
  entityType       String?      @map("entity_type")
  entityId         String?      @map("entity_id")
  outcome          AuditOutcome @default(SUCCESS)
  ip               String?
  userAgent        String?      @map("user_agent")
  correlationId    String?      @map("correlation_id")
  metadata         Json         @default("{}")
  /// Changed fields only, redacted and size-bounded.
  before           Json?
  after            Json?
  reason           String?
  /// Workflow instance this action was performed as part of.
  sourceWorkflowId String?      @map("source_workflow_id") @db.Uuid

  @@index([organisationId, companyId, occurredAt(sort: Desc)])
  @@index([organisationId, entityType, entityId])
  @@index([organisationId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("audit_event")
}

model JobRecord {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String?         @map("organisation_id") @db.Uuid
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  queue           String
  type            String
  status          JobRecordStatus @default(QUEUED)
  idempotencyKey  String          @map("idempotency_key")
  correlationId   String          @map("correlation_id")
  /// W3C trace id (32 hex) of the enqueuing request; restored in the worker.
  traceId         String?         @map("trace_id")
  /// Company the job concerns (composite FK with organisation_id); jobs are listed only to people who can read that company.
  companyId       String?         @map("company_id") @db.Uuid
  payload         Json
  result          Json?
  error           String?
  attempts        Int             @default(0)
