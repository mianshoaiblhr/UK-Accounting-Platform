// V0 baseline. Hand-written SQL (RLS, grants, triggers, exclusion constraints) lives in
// prisma/migrations/*_v0_security/migration.sql and MUST be applied with `migrate deploy`.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("MIGRATION_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganisationType {
  PRACTICE
  BUSINESS
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CompanyScope {
  ALL
  ASSIGNED
}

enum PlatformRole {
  NONE
  SUPPORT
  ADMIN
}

enum PracticeStatus {
  ACTIVE
  ARCHIVED
}

enum ContactKind {
  PERSON
  ORGANISATION
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
}

enum AddressKind {
  REGISTERED_OFFICE
  TRADING
  CORRESPONDENCE
  RESIDENTIAL
  OTHER
}

enum OfficerRole {
  DIRECTOR
  SECRETARY
  PERSON_WITH_SIGNIFICANT_CONTROL
  MEMBER
  PARTNER
  TRUSTEE
  OTHER
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum MfaFactorType {
  TOTP
}

enum MfaFactorStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentVersionStatus {
  PENDING_UPLOAD
  UPLOADED
  SCANNING
  AVAILABLE
  QUARANTINED
  FAILED
}

enum JobRecordStatus {
  QUEUED
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  DEAD
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum IntegrationStatus {
  ACTIVE
  REVOKED
  ERROR
}

enum AiRunStatus {
  SUCCEEDED
  FAILED
}

enum AiProposalStatus {
  SUGGESTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

// ───────────── Global (not tenant-scoped) ─────────────
/// Per-organisation override of a feature flag (registry in @uk/contracts/features). No row = the environment/registry default applies.
model FeatureFlagOverride {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  key            String
  enabled        Boolean
  reason         String?
  setByUserId    String   @map("set_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organisationId, key])
  @@map("feature_flag_override")
}

model User {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String       @unique
  displayName       String       @map("display_name")
  passwordHash      String?      @map("password_hash")
  emailVerifiedAt   DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  status            UserStatus   @default(ACTIVE)
  /// Platform-level role. Confers NO tenant data access (see authz.ts).
  platformRole      PlatformRole @default(NONE) @map("platform_role")
  failedLoginCount  Int          @default(0) @map("failed_login_count")
  lockedUntil       DateTime?    @map("locked_until") @db.Timestamptz(3)
  lockoutLevel      Int          @default(0) @map("lockout_level")
  lastLoginAt       DateTime?    @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?    @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  identities    UserIdentity[]
  sessions      Session[]
  authTokens    AuthToken[]
  mfaFactors    MfaFactor[]
  recoveryCodes MfaRecoveryCode[]
  challenges    AuthChallenge[]
  memberships   OrganisationMembership[]

  @@map("user")
}

/// External identity links (OIDC/SAML later). `local` provider subject = user id.
model UserIdentity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  provider  String
  subject   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identity")
}

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  authMethod        String    @map("auth_method")
  mfaVerifiedAt     DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  ip                String?
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model AuthToken {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_token")
}

model MfaFactor {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  type            MfaFactorType   @default(TOTP)
  secretEncrypted String          @map("secret_encrypted")
  status          MfaFactorStatus @default(PENDING)
  lastUsedStep    BigInt?         @map("last_used_step")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt     DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("mfa_factor")
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_code")
}

/// Short-lived second-step login challenge issued after the first factor succeeds.
model AuthChallenge {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_challenge")
}

// ───────────── Tenant-scoped (organisation_id, RLS) ─────────────
model Organisation {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      OrganisationType
  name      String
  status    OrganisationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles       Role[]
  memberships OrganisationMembership[]
  practices   Practice[]
  companies   Company[]

  @@map("organisation")
}

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL = system role visible to every organisation.
  organisationId String?  @map("organisation_id") @db.Uuid
  key            String
  name           String
  description    String   @default("")
  permissions    String[]
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation        Organisation?            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberships         OrganisationMembership[]
  practiceMemberships PracticeMembership[]
  companyMemberships  CompanyMembership[]

  @@unique([organisationId, key])
  @@map("role")
}

/// A user's membership of an organisation (tenant). The gate for all access; carries the organisation-level role and reach.
model OrganisationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  /// Reach: ALL = organisation-wide default access; ASSIGNED = only practices/companies granted explicitly.
  companyScope   CompanyScope     @default(ALL) @map("company_scope")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                Role                 @relation(fields: [roleId], references: [id])
  practiceMemberships PracticeMembership[]
  companyMemberships  CompanyMembership[]

  @@unique([organisationId, userId])
  @@unique([organisationId, id])
  @@index([userId])
  @@map("organisation_membership")
}

/// An accountancy practice inside a PRACTICE organisation. Direct (BUSINESS) organisations have none.
model Practice {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  name           String
  status         PracticeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  companies    Company[]
  members      PracticeMembership[]

  @@unique([organisationId, id])
  @@unique([organisationId, name])
  @@map("practice")
}

/// Practice-level role: PRACTICE permissions on this practice, and the default role on its companies.
model PracticeMembership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  practiceId     String   @map("practice_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  practice   Practice               @relation(fields: [organisationId, practiceId], references: [organisationId, id], onDelete: Cascade)
  membership OrganisationMembership @relation(fields: [organisationId, membershipId], references: [organisationId, id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id])

  @@unique([practiceId, membershipId])
  @@index([membershipId])
  @@map("practice_membership")
}

/// Company-level role (most specific grant; replaces broader grants for this company). Formerly company_assignment.
model CompanyMembership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership OrganisationMembership @relation(fields: [organisationId, membershipId], references: [organisationId, id], onDelete: Cascade)
  company    Company                @relation(fields: [organisationId, companyId], references: [organisationId, id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id])

  @@unique([membershipId, companyId])
  @@index([companyId])
  @@map("company_membership")
}

model Invitation {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String       @map("organisation_id") @db.Uuid
  email           String
  roleId          String       @map("role_id") @db.Uuid
  companyScope    CompanyScope @default(ALL) @map("company_scope")
  companyIds      String[]     @map("company_ids") @db.Uuid
  tokenHash       String       @unique @map("token_hash")
  invitedByUserId String       @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime     @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?    @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organisationId])
  @@map("invitation")
}

model Company {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String        @map("organisation_id") @db.Uuid
  name                String
  /// Registered number held as plain data only; no Companies House integration in V0.
  companyNumber       String?       @map("company_number")
  incorporationDate   DateTime?     @map("incorporation_date") @db.Date
  /// Financial year-end as a month/day pair (29 Feb = last day of February).
  yearEndMonth        Int?          @map("year_end_month") @db.SmallInt
  yearEndDay          Int?          @map("year_end_day") @db.SmallInt
  baseCurrency        String        @default("GBP") @map("base_currency") @db.Char(3)
  /// Country of incorporation / registration.
  countryCode         String        @default("GB") @map("country_code") @db.Char(2)
  /// Primary tax jurisdiction code (effective-dated definitions live in tax_jurisdiction).
  taxJurisdictionCode String?       @map("tax_jurisdiction_code")
  /// Managing practice (explicit relationship). Required for PRACTICE organisations, forbidden for BUSINESS (trigger).
  practiceId          String?       @map("practice_id") @db.Uuid
  legalForm           String        @default("LTD") @map("legal_form")
  status              CompanyStatus @default(ACTIVE)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  practice     Practice?           @relation(fields: [organisationId, practiceId], references: [organisationId, id])
  periods      AccountingPeriod[]
  memberships  CompanyMembership[]
  contacts     Contact[]
  addresses    Address[]
  officers     CompanyOfficer[]

  @@unique([organisationId, id])
  @@index([organisationId])
  @@index([organisationId, practiceId])
  @@map("company")
}

// ───────────── Master data ─────────────
/// ISO 4217 reference data (global, read-only for the runtime role).
model Currency {
  code        String @id @db.Char(3)
  numericCode String @unique @map("numeric_code") @db.Char(3)
  name        String
  minorUnits  Int    @map("minor_units") @db.SmallInt

  @@map("currency")
}

/// ISO 3166-1 reference data (global, read-only for the runtime role).
model Country {
  alpha2      String @id @db.Char(2)
  alpha3      String @unique @db.Char(3)
  numericCode String @unique @map("numeric_code") @db.Char(3)
  name        String

  taxJurisdictions TaxJurisdiction[]

  @@map("country")
}

/// Effective-dated tax jurisdiction (global reference). No overlapping definitions of one code (exclusion constraint).
model TaxJurisdiction {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String
  countryCode String    @map("country_code") @db.Char(2)
  name        String
  authority   String
  validFrom   DateTime  @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date

  country Country @relation(fields: [countryCode], references: [alpha2])

  @@index([countryCode])
  @@map("tax_jurisdiction")
}

model Contact {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String        @map("organisation_id") @db.Uuid
  /// Null = an organisation-level contact; set = belongs to one company (and follows that company's access rules).
  companyId       String?       @map("company_id") @db.Uuid
  kind            ContactKind
  name            String
  email           String?
  phone           String?
  reference       String?
  labels          String[]      @default([])
  notes           String?
  /// Counterparty VAT number, format-checked only (DEC-024).
  vatNumber       String?       @map("vat_number")
  status          ContactStatus @default(ACTIVE)
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company?         @relation(fields: [organisationId, companyId], references: [organisationId, id], onDelete: Cascade)
  addresses Address[]
  officers  CompanyOfficer[]

  @@unique([organisationId, id])
  @@index([organisationId, companyId])
  @@map("contact")
}

model Address {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String      @map("organisation_id") @db.Uuid
  companyId      String?     @map("company_id") @db.Uuid
  contactId      String?     @map("contact_id") @db.Uuid
  kind           AddressKind
  line1          String
  line2          String?
  line3          String?
  city           String
  region         String?
  postcode       String?
  countryCode    String      @map("country_code") @db.Char(2)
  isPrimary      Boolean     @default(false) @map("is_primary")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company? @relation(fields: [organisationId, companyId], references: [organisationId, id], onDelete: Cascade)
  contact Contact? @relation(fields: [organisationId, contactId], references: [organisationId, id], onDelete: Cascade)

  @@index([organisationId, companyId])
  @@index([organisationId, contactId])
  @@map("address")
}

/// A person or organisation holding an office at a company. History is kept: resignation sets resigned_on.
model CompanyOfficer {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String      @map("organisation_id") @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  contactId      String      @map("contact_id") @db.Uuid
  role           OfficerRole
  appointedOn    DateTime    @map("appointed_on") @db.Date
  resignedOn     DateTime?   @map("resigned_on") @db.Date
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [organisationId, companyId], references: [organisationId, id], onDelete: Cascade)
  contact Contact @relation(fields: [organisationId, contactId], references: [organisationId, id])

  @@unique([companyId, contactId, role, appointedOn])
  @@index([organisationId, companyId])
  @@index([organisationId, contactId])
  @@map("company_officer")
}

/// Period shell only: dates + status. No accounting semantics until V1+.
model AccountingPeriod {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  status         PeriodStatus @default(OPEN)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Who/when/why the state last changed (V1 period controls).
  statusChangedAt       DateTime? @map("status_changed_at") @db.Timestamptz(3)
  statusChangedByUserId String?   @map("status_changed_by_user_id") @db.Uuid
  statusReason          String?   @map("status_reason")

  company Company @relation(fields: [organisationId, companyId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@index([organisationId, companyId])
  @@map("accounting_period")
}

model Document {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId         String         @map("organisation_id") @db.Uuid
  /// Optional company link; composite FK (organisation_id, company_id) added in raw SQL.
  companyId              String?        @map("company_id") @db.Uuid
  name                   String
  /// Document type code (FK to document_type).
  documentClass          String         @default("GENERAL") @map("document_class")
  status                 DocumentStatus @default(ACTIVE)
  retainUntil            DateTime?      @map("retain_until") @db.Date
  legalHold              Boolean        @default(false) @map("legal_hold")
  createdByUserId        String         @map("created_by_user_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Folder and period must belong to the document's company (trigger).
  folderId               String?        @map("folder_id") @db.Uuid
  periodId               String?        @map("period_id") @db.Uuid
  description            String?
  documentDate           DateTime?      @map("document_date") @db.Date
  reference              String?
  labels                 String[]       @default([])
  metadata               Json           @default("{}")
  /// STANDARD | RESTRICTED (restricted: creator, explicit grants, document:confidential holders).
  visibility             String         @default("STANDARD")
  /// Filing evidence lock (one-way, trigger-enforced). All five are set together or not at all.
  evidenceLockedAt       DateTime?      @map("evidence_locked_at") @db.Timestamptz(3)
  evidenceLockedByUserId String?        @map("evidence_locked_by_user_id") @db.Uuid
  evidenceVersionId      String?        @map("evidence_version_id") @db.Uuid
  evidenceSha256         String?        @map("evidence_sha256")
  evidenceReason         String?        @map("evidence_reason")

  versions DocumentVersion[]
  folder   DocumentFolder?   @relation(fields: [organisationId, folderId], references: [organisationId, id])
  access   DocumentAccess[]

  @@unique([organisationId, id])
  @@index([organisationId, companyId])
  @@index([organisationId, folderId])
  @@index([organisationId, periodId])
  @@index([organisationId, documentClass])
  @@map("document")
}

/// Reference data, SELECT-only for the runtime role.
model DocumentType {
  code String @id
  name String

  @@map("document_type")
}

model DocumentFolder {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  companyId       String?  @map("company_id") @db.Uuid
  parentId        String?  @map("parent_id") @db.Uuid
