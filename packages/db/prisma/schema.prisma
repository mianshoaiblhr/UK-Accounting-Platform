  credentialsEncrypted String?           @map("credentials_encrypted")
  scopes               String[]
  createdByUserId      String            @map("created_by_user_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastCheckedAt        DateTime?         @map("last_checked_at") @db.Timestamptz(3)
  lastError            String?           @map("last_error")

  @@index([organisationId, provider])
  @@map("integration_connection")
}

/// Every AI invocation is logged (hashes, not content) for audit and cost control.
model AiRun {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String      @map("organisation_id") @db.Uuid
  userId           String?     @map("user_id") @db.Uuid
  purpose          String
  provider         String
  model            String
  inputHash        String      @map("input_hash")
  outputHash       String?     @map("output_hash")
  status           AiRunStatus
  promptTokens     Int?        @map("prompt_tokens")
  completionTokens Int?        @map("completion_tokens")
  latencyMs        Int?        @map("latency_ms")
  error            String?
  correlationId    String      @map("correlation_id")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organisationId, createdAt(sort: Desc)])
  @@map("ai_run")
}

/// AI output is only ever a PROPOSAL. Applying it needs an authorised human decision.
model AiProposal {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId        String           @map("organisation_id") @db.Uuid
  companyId             String?          @map("company_id") @db.Uuid
  aiRunId               String?          @map("ai_run_id") @db.Uuid
  kind                  String
  payload               Json
  status                AiProposalStatus @default(SUGGESTED)
  /// Provenance: which model/provider produced it, with what prompt, how confident, from which evidence.
  provider              String?
  model                 String?
  promptVersion         String?          @map("prompt_version")
  confidence            Decimal?         @db.Decimal(5, 4)
  sourceEvidence        Json             @default("[]") @map("source_evidence")
  reviewStartedByUserId String?          @map("review_started_by_user_id") @db.Uuid
  reviewStartedAt       DateTime?        @map("review_started_at") @db.Timestamptz(3)
  /// Set only by the authorised application service that acted on an ACCEPTED proposal (never by AI).
  appliedAt             DateTime?        @map("applied_at") @db.Timestamptz(3)
  appliedByUserId       String?          @map("applied_by_user_id") @db.Uuid
  appliedReference      String?          @map("applied_reference")
  workflowInstanceId    String?          @map("workflow_instance_id") @db.Uuid
  requestedByUserId     String?          @map("requested_by_user_id") @db.Uuid
  decidedByUserId       String?          @map("decided_by_user_id") @db.Uuid
  decidedAt             DateTime?        @map("decided_at") @db.Timestamptz(3)
  decisionComment       String?          @map("decision_comment")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organisationId, status])
  @@map("ai_proposal")
}

// ───────────── Notification channels (ADR-38) ─────────────
