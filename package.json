{
  "name": "uk-accounting-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @uk/db generate",
    "db:migrate": "pnpm --filter @uk/db migrate:deploy",
    "services:up": "bash scripts/dev-services.sh",
    "test": "vitest run --project '!e2e'",
    "test:e2e": "vitest run --project e2e",
    "test:regression": "vitest run --project '!e2e' -t regression"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@swc/core": "^1.10.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.20.0",
    "ioredis": "^5.11.1",
    "playwright": "^1.64.0",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.3.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.24.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "@swc/core",
      "esbuild",
      "sharp",
      "@nestjs/core"
    ]
  }
}
