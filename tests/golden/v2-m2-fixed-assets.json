    { "key": "A2", "class": "MOTOR", "description": "Van", "acquiredOn": "2026-07-01", "inUseFrom": "2026-07-01", "cost": "12000.00", "addition": { "kind": "POSTED", "offsetAccount": "2230" },
      "residual": "1000.00", "tax": { "category": "MAIN_POOL", "cost": "12000.00" } }
