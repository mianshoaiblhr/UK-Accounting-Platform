  "steps": [
    { "do": "run", "asAt": "2025-12-31", "expect": { "lines": { "A3": "1200.00" }, "journal": [["6900", "1200.00", "0.00"], ["0031", "0.00", "1200.00"]], "total": "1200.00" },
      "why": "A3 straight line daily: 2,400 x 365 days (1.1.2025-31.12.2025) / 730 days of life (1.1.2025-31.12.2026) = 1,200.00. A4's basis starts the day after take-on (1.1.2026): nothing yet." },
