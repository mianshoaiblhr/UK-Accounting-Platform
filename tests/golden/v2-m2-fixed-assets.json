        "reconciliation": { "0030": ["8600.00", "8600.00"], "0031": ["4000.00", "4000.00"], "0040": ["12000.00", "12000.00"], "0041": ["1512.33", "1512.33"] } },
      "why": "Register and ledger at 31.12.2026 (cost accounts debit, depreciation accounts credit). 0030: 2,400 + 5,000 + 3,600 - 2,400 = 8,600. 0031: 2,000 + 1,200 + 595.07 - 1,795.07 + 900 + 1,100 = 4,000. A disposed asset shows its figures at disposal and is left out of the totals." },
    { "do": "ledger", "expect": { "6900": { "2025": "1200.00", "2026": "4107.40" }, "6950": { "2026": "-395.07" } },
      "why": "Depreciation expense 2026: 595.07 + 900 + 2,612.33 = 4,107.40. Disposal account net credit 395.07 (a gain), shown debit-positive." },
    { "do": "estimate", "asset": "A1", "lifeMonths": 13, "residual": "0.00", "reason": "Laptops to be replaced at the end of January 2028",
      "expect": { "effectiveFrom": "2027-01-01", "carryingAtBasis": "2600.00" },
      "why": "Prospective: the new basis starts the day after the last charged date (31.12.2026) at the carrying amount then, 3,600 - 1,000 = 2,600, over the 13 remaining months." },
    { "do": "run", "asAt": "2027-01-31", "expect": { "lines": { "A1": "200.00", "A4": "83.33", "A2": "254.79" },
        "journal": [["6900", "283.33", "0.00"], ["0031", "0.00", "283.33"], ["6900", "254.79", "0.00"], ["0041", "0.00", "254.79"]], "total": "538.12" },
      "why": "A1: 2,600 / 13 = 200.00. A4: 2,000 + 2,500 x 13 / 30 = 3,083.333 -> 3,083.33 less 3,000.00 charged = 83.33. A2: 215 days (1.7.2026-31.1.2027) / 365: 12,000 x 0.25 x 215 / 365 = 1,767.1233 -> 1,767.12 less 1,512.33 = 254.79." }
