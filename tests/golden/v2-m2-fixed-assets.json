    { "do": "run", "asAt": "2026-12-31", "expect": { "lines": { "A1": "600.00", "A4": "500.00", "A2": "1512.33" },
        "journal": [["6900", "1100.00", "0.00"], ["0031", "0.00", "1100.00"], ["6900", "1512.33", "0.00"], ["0041", "0.00", "1512.33"]], "total": "2612.33" },
      "why": "A1: 10 months x 100 = 1,000 - 400 = 600.00. A4: 2,500 x 12 / 30 = 1,000 - 500 = 500.00. A2 reducing balance 25% daily: 184 days (1.7-31.12.2026) of a 365-day asset year: 12,000 x 0.25 x 184 / 365 = 1,512.3288 -> 1,512.33." },
    { "do": "register", "asAt": "2026-12-31", "expect": {
