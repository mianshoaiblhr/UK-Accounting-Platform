NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
# Database: runtime role (RLS enforced) and migrator (owner)
DATABASE_URL=postgresql://uk_app:uk_app_dev@localhost:5432/uk_accounting
MIGRATION_DATABASE_URL=postgresql://postgres@localhost:5432/uk_accounting
REDIS_URL=redis://localhost:6379
# Residency: application refuses to start in production outside these regions
AWS_REGION=eu-west-2
DATA_RESIDENCY_REGIONS=eu-west-2
STORAGE_DRIVER=local          # s3 | local
STORAGE_LOCAL_DIR=.tmp/storage
S3_BUCKET=
EMAIL_DRIVER=console          # ses | console | file | memory
EMAIL_FROM=no-reply@example.test
AV_DRIVER=noop                # clamav | noop
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# 32 bytes base64:  openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
